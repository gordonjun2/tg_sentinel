BOT_TOKEN=<your_bot_token>
ADMIN_GROUP_ID=<your_admin_group_id>
TARGET_GROUP_ID=<your_target_group_id>
GOOGLE_DRIVE_MAIN_FOLDER_ID=<your_google_drive_main_folder_id>
GOOGLE_DRIVE_DISCUSSION_INSIGHTS_FOLDER_ID=<your_google_drive_discussion_insights_folder_id>
GOOGLE_DRIVE_TRANSCRIPTIONS_FOLDER_ID=<your_google_drive_transcriptions_folder_id>
GEMINI_API_KEY=<your_gemini_api_key>
TELEGRAM_API_KEY=<your_telegram_api_key>
TELEGRAM_HASH=<your_telegram_hash>
FIRECRAWL_API_KEY=<your_firecrawl_api_key>
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_ENRICHMENT_MODEL=gpt-5-mini
AI_CONTEXT_WINDOW=3
GEMINI_ENRICHMENT_MODEL=gemini-2.5-flash
AI_ENRICHMENT_ENABLED_DEFAULT=true

# Gmail + Google Calendar integration (gmail_calendar package)
# GCP project that owns the Pub/Sub topic (required for Gmail push to work)
GOOGLE_GMAIL_CAL_PROJECT_ID=your_gcp_project_id
GOOGLE_PUBSUB_TOPIC=gmail-events
GOOGLE_PUBSUB_SUBSCRIPTION=gmail-events-pull
# OAuth client secrets downloaded from GCP for THIS integration only.
# Default: gmail_cal_credentials.json (separate from the Drive credentials.json).
# GMAIL_CALENDAR_CREDENTIALS_FILE=gmail_cal_credentials.json
# Importance threshold: emails scoring >= this get forwarded to admin group
# 0.5 = balanced (skip marketing/newsletters, forward most real correspondence)
# 0.75 = strict (only personal/action-required/billing/security/meetings)
GMAIL_IMPORTANCE_THRESHOLD=0.5
GMAIL_POLL_INTERVAL_SECONDS=60
CALENDAR_POLL_INTERVAL_SECONDS=60
REMINDER_CHECK_INTERVAL_SECONDS=60
REMINDER_LEAD_MINUTES=30